<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E5E7EB">

    <LinearLayout
        android:id="@+id/layoutHomeHub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="#F3F4F6"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UniOffice 365 Pro"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ชุดโปรแกรมสำนักงานฉบับเต็มสำหรับ OPPO Pad 5 รองรับปากกา Stylus"
            android:textSize="15sp"
            android:textColor="#4B5563"
            android:layout_marginBottom="32dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnOpenWord"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_margin="10dp"
                android:text="W\n\nWord\nรายงาน ตาราง รูปภาพ"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#185ABD" />

            <Button
                android:id="@+id/btnOpenExcel"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_margin="10dp"
                android:text="X\n\nExcel\nตารางและแถบสูตร fx"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#107C41" />

            <Button
                android:id="@+id/btnOpenPpt"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_margin="10dp"
                android:text="P\n\nPowerPoint\nสไลด์และนำเสนอ"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#C43E1C" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutEditorWorkspace"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <HorizontalScrollView
            android:id="@+id/ribbonTopScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#185ABD">

            <LinearLayout
                android:id="@+id/ribbonTopBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingTop="6dp"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnBackHome"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="ไฟล์"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="#FFFFFF"
                    android:textColor="#185ABD"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Word"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginEnd="14dp" />

                <Button
                    android:id="@+id/tabHome"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="หน้าแรก"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="#F3F4F6"
                    android:textColor="#185ABD"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/tabInsert"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="แทรก"
                    android:textSize="13sp"
                    android:backgroundTint="#2B6CB0"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/tabDraw"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="วาดเขียน"
                    android:textSize="13sp"
                    android:backgroundTint="#2B6CB0"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/tabLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="เค้าโครง"
                    android:textSize="13sp"
                    android:backgroundTint="#2B6CB0"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/tabView"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="มุมมอง / นำเสนอ"
                    android:textSize="13sp"
                    android:backgroundTint="#2B6CB0"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </HorizontalScrollView>

        <HorizontalScrollView
            android:id="@+id/ribbonSubBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F3F4F6"
            android:padding="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 1. แท็บ หน้าแรก (Rich Text คลุมดำเฉพาะคำ) -->
                <LinearLayout
                    android:id="@+id/groupHomeTools"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="visible">

                    <Button
                        android:id="@+id/btnFontFamily"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="TH Sarabun ▼"
                        android:textSize="12sp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnFontSize"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="18 ▼"
                        android:textSize="12sp"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnBold"
                        android:layout_width="40dp"
                        android:layout_height="38dp"
                        android:text="B"
                        android:textStyle="bold"
                        android:layout_marginEnd="2dp" />

                    <Button
                        android:id="@+id/btnItalic"
                        android:layout_width="40dp"
                        android:layout_height="38dp"
                        android:text="I"
                        android:textStyle="italic"
                        android:layout_marginEnd="2dp" />

                    <Button
                        android:id="@+id/btnUnderline"
                        android:layout_width="40dp"
                        android:layout_height="38dp"
                        android:text="U"
                        android:layout_marginEnd="2dp" />

                    <Button
                        android:id="@+id/btnStrike"
                        android:layout_width="40dp"
                        android:layout_height="38dp"
                        android:text="S"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnTextColor"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="A สีตัวอักษร"
                        android:textSize="12sp"
